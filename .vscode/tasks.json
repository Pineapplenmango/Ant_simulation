{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Ant Simulation (MSVC)",
      "type": "shell",
      "command": "cl",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/c"]
        }
      },
      "args": [
        "/std:c++17",
        "/Zi", "/Od", "/EHsc", "/MD",
        "src\\main.cpp",
        "src\\simulation\\ant\\*.cpp",
        "src\\simulation\\ant_system\\*.cpp",
        "src\\simulation\\map_system\\*.cpp",
        "src\\simulation\\controller\\*.cpp",
        "src\\simulation\\cell\\*.cpp",
        "/I", "C:\\Users\\Andre\\Documents\\raylib_msvc\\raylib-5.5_win64_msvc16\\include",
        "/link",
        "C:\\Users\\Andre\\Documents\\raylib_msvc\\raylib-5.5_win64_msvc16\\lib\\raylib.lib",
        "opengl32.lib",
        "gdi32.lib",
        "winmm.lib",
        "user32.lib",
        "shell32.lib",
        "ole32.lib",
        "uuid.lib",
        "advapi32.lib",
        "comdlg32.lib",
        "/DEBUG",
        "/OUT:ant_simulation.exe"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    }
  ]
}
